{
  "method": {
    "name": "lora",
    "lora": {
      "r": 16,
      "alpha": 32,
      "dropout": 0.05,
      "bias": "none",
      "target_modules": "all-linear"
    }
  },
  "training": {
    "learning_rate": 0.0002,
    "num_train_epochs": 1,
    "per_device_train_batch_size": 2,
    "gradient_accumulation_steps": 8,
    "warmup_ratio": 0.03,
    "weight_decay": 0.0,
    "max_grad_norm": 1.0,
    "gradient_checkpointing": true,
    "report_to": "none"
  }
}
