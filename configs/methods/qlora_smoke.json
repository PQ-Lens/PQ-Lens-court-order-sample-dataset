{
  "method": {
    "name": "qlora",
    "quantization": {
      "bits": 4,
      "type": "nf4",
      "double_quant": true
    },
    "lora": {
      "r": 8,
      "alpha": 16,
      "dropout": 0.05,
      "bias": "none"
    }
  },
  "training": {
    "learning_rate": 0.0002,
    "num_train_epochs": 1,
    "max_steps": 10,
    "per_device_train_batch_size": 1,
    "per_device_eval_batch_size": 1,
    "gradient_accumulation_steps": 4,
    "warmup_ratio": 0.03,
    "weight_decay": 0.0,
    "max_grad_norm": 1.0,
    "logging_steps": 1,
    "eval_steps": 5,
    "save_strategy": "no",
    "bf16": true,
    "fp16": false,
    "gradient_checkpointing": true,
    "report_to": "none"
  }
}
